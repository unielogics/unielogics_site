# Dev-only overrides — picked up by `vite dev`, ignored by production builds.
# Point the frontend at the Vite dev proxy paths (see vite.config.js) so browser
# requests stay same-origin. Production uses the defaults baked into the code:
#   uniesales:  https://api.uniesales.com
#   cortex:     https://api.uniecortex.com/v1/public/intake
VITE_UNIESALES_INTAKE_URL=/api/uniesales-intake
VITE_CORTEX_INTAKE_URL=/api/uniecortex-intake/v1/public/intake
